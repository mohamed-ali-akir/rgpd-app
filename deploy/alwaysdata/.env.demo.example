# Démo publique sur akir.alwaysdata.net/efface-moi (offre gratuite alwaysdata).
# À copier en ~/efface-moi/.env sur le serveur, puis : php artisan key:generate
# Données fictives uniquement : aucun e-mail envoyé, aucune recherche réelle, réinitialisation chaque nuit.

APP_NAME="Efface-moi"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Le chemin /efface-moi est retiré par alwaysdata (« Exclure le chemin ») : APP_URL le remet dans les liens générés.
APP_URL=https://akir.alwaysdata.net/efface-moi
APP_DEMO=true

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_DISPLAY_TIMEZONE=Europe/Paris
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=7

# SQLite (fichier database/database.sqlite) : suffisant pour une démo, et rien à créer dans MySQL.
DB_CONNECTION=sqlite

# Cookies limités à /efface-moi, avec un nom propre : ils ne se mélangent pas avec ceux de StagePilot,
# servi à la racine du même domaine.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/efface-moi
SESSION_COOKIE=efface_moi_session
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=akir.alwaysdata.net

# Pas de worker permanent sur l'offre gratuite : les jobs s'exécutent pendant la requête.
# En démo ils sont instantanés (envoi et scanner fictifs).
QUEUE_CONNECTION=sync
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Les e-mails de l'application (alertes de délai…) sont seulement écrits dans les logs.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@akir.alwaysdata.net"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SENDER=fake

SEARCH_PROVIDER=none
