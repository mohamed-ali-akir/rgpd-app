# Modèle de .env pour la PRODUCTION (à copier en backend/.env sur le serveur, jamais commité rempli).
# Remplacer chaque valeur entre <...>. Voir deploy/README.md.

APP_NAME="Efface-moi"
APP_ENV=production
APP_KEY=
# Ne jamais activer en production : les pages d'erreur afficheraient la configuration et des données.
APP_DEBUG=false
APP_URL=https://<votre-domaine>

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_DISPLAY_TIMEZONE=Europe/Paris

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Journaux : seulement les avertissements et erreurs, rotation quotidienne sur 14 jours.
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rgpd_app
DB_USERNAME=rgpd_app
DB_PASSWORD=<mot-de-passe-mysql>

# Sessions : cookie HTTPS uniquement, chiffré, non lisible par le JavaScript (HttpOnly par défaut).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=<votre-domaine>

QUEUE_CONNECTION=database
# Un scan peut durer plusieurs minutes (RunScanJob : 600 s). La file doit attendre PLUS longtemps
# avant de considérer un job comme perdu, sinon il serait lancé deux fois. Worker : --timeout=650.
DB_QUEUE_RETRY_AFTER=700
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# SMTP de l'application (vérification d'e-mail, mot de passe oublié, alertes de délai).
# Ce n'est PAS le Gmail des utilisateurs : il faut un fournisseur d'envoi transactionnel.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<smtp.fournisseur>
MAIL_PORT=587
MAIL_USERNAME=<identifiant-smtp>
MAIL_PASSWORD=<mot-de-passe-smtp>
MAIL_FROM_ADDRESS="no-reply@<votre-domaine>"
MAIL_FROM_NAME="${APP_NAME}"

# Envoi des demandes depuis le Gmail des utilisateurs.
MAIL_SENDER=gmail
GOOGLE_CLIENT_ID=<id-client-oauth>
GOOGLE_CLIENT_SECRET=<secret-client-oauth>
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"

# Scanner (V2) : moteur de recherche web. "none" (défaut), "fake" (démo/tests) ou "searxng" (auto-hébergé).
SEARCH_PROVIDER=none
SEARXNG_URL=
# Mode démo : aucun envoi réel, moteur simulé, inscription et Gmail désactivés, compte de démo réinitialisé chaque nuit.
APP_DEMO=false
